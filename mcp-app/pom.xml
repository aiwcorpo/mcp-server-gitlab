<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-app: bootstrap and the only deployable artifact (target/mcp-gitlab.jar). Assembles the hexagon
  and registers the tools; tests run the whole server over HTTP behind the TestGateway of mcp-platform-test.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.aiwcorpo.mcp.gitlab</groupId>
        <artifactId>mcp-gitlab-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>mcp-app</artifactId>
    <name>mcp-gitlab :: App (bootstrap)</name>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>mcp-tools</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>mcp-integration</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>pl.aiwcorpo.mcp</groupId><artifactId>mcp-platform-starter</artifactId></dependency>

        <!-- Stands in for the gateway in tests (test JWKS, internal JWTs, C3 headers). Never outside test scope. -->
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-platform-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>mcp-gitlab</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              The manifest that CI registers (target/mcp-manifest.json) is written by ManifestArtifactTest, which starts
              the server with the version of this pom and the credential types of application.yml. It runs in its own
              execution in the package phase: a plain build produces it too, and -DskipTests does not skip it because
              skipTests is set explicitly here. The default execution leaves it out, so only one context writes the file.
            -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes><exclude>**/ManifestArtifactTest.java</exclude></excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>manifest-artifact</id>
                        <phase>package</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skipTests>false</skipTests>
                            <skip>false</skip>
                            <test>ManifestArtifactTest</test>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                            <systemPropertyVariables>
                                <manifest.version>${project.version}</manifest.version>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
