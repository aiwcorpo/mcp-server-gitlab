# Configuration of mcp-gitlab. Fill in the empty values.
# No backend credential here: the gateway sends the user's own credential with every call.

# Password of certs/keystore.p12 and certs/truststore.p12 (one password for both).
MCP_TLS_STORE_PASSWORD=

# Gateway: JWKS of the internal JWT and the policy data (scope mapping, allowed AI clients, emergency overrides). Both are
# fetched over TLS of the internal CA; the policy data with this server's own certificate.
MCP_GATEWAY_JWKS_URI=https://mcp-gateway.internal:8443/.well-known/jwks.json
MCP_GATEWAY_POLICY_DATA_URL=https://mcp-gateway.internal:8443/internal/v1/policy-data
# Only when the host in the URLs above is not a name in the gateway certificate:
# MCP_GATEWAY_TLS_NAME=mcp-gateway.internal

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# Key of the paging cursors (Base64, at least 32 bytes: openssl rand -base64 32). The same value on every instance.
MCP_PAGING_CURSOR_KEY=

# GitLab instance root, without /api/v4; MCP_GITLAB_SSL_BUNDLE only when it needs a non-default trust store.
MCP_GITLAB_URL=
# Largest file get_file returns, in bytes (default 262144).
#MCP_GITLAB_FILE_MAX_BYTES=262144
# Largest job log get_job_log reads to find its end (default 8MB); a larger log is refused.
#MCP_GITLAB_MAX_LOG_SIZE=8MB

# Redis for the one-time jti, started by compose.yaml next to the server (ACL user mcp-gitlab, keys jti:mcp-gitlab:*, command SET).
# Choose the password (openssl rand -hex 24); compose.yaml sets MCP_REDIS_HOST.
MCP_REDIS_HOST=
MCP_REDIS_PORT=6379
MCP_REDIS_USER=mcp-gitlab
MCP_REDIS_PASSWORD=

# The address the gateway reaches this server at, for the manifest (informative; the gateway has its own entry).
MCP_INTERNAL_URL=https://mcp-gitlab.internal:8443/mcp
# The first type is the default of the system: OAuth, with a personal access token as the second way to connect.
MCP_ACCEPTED_CREDENTIAL_TYPES=user-oauth,user-secret
