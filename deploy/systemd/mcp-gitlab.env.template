# Environment of the mcp-gitlab service: copy to /etc/mcp-gitlab/mcp-gitlab.env (root:mcp, 0640).
# The real file is never committed. Prefer rendering it from the secrets store at deploy time.
# No backend credential here: the gateway sends the user's credential with every call (C3).

# mTLS: this server's certificate (CN mcp-gitlab, SAN mcp-gitlab.internal, server and client use) and the internal CA, both PKCS12.
MCP_TLS_KEYSTORE=/etc/mcp-gitlab/tls/keystore.p12
MCP_TLS_TRUSTSTORE=/etc/mcp-gitlab/tls/truststore.p12
MCP_TLS_STORE_PASSWORD=

# Gateway: JWKS of the internal JWT (C2), served over TLS signed by the internal CA.
MCP_GATEWAY_JWKS_URI=https://mcp-gateway.internal:8443/.well-known/jwks.json

# Policy data (scope mapping, allowed AI clients, emergency overrides) of the gateway, fetched over mTLS with this server's
# own certificate (the gateway reads the server id from its CN). The policies themselves are in the jar.
MCP_GATEWAY_POLICY_DATA_URL=https://mcp-gateway.internal:8443/internal/v1/policy-data
# Only when the host in the URL is not a name in the gateway certificate:
# MCP_GATEWAY_TLS_NAME=mcp-gateway.internal

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# GitLab instance root, without /api/v4; MCP_GITLAB_SSL_BUNDLE only when it needs a non-default trust store.
MCP_GITLAB_URL=
# Largest file get_file returns, in bytes (default 262144).
#MCP_GITLAB_FILE_MAX_BYTES=262144

# Largest job log get_job_log reads to find its end (default 8MB); a larger log is refused.
#MCP_GITLAB_MAX_LOG_SIZE=8MB

# HMAC key of the paging cursors, Base64 of at least 32 random bytes (openssl rand -base64 32); the same on every instance.
MCP_PAGING_CURSOR_KEY=

# Redis for one-time jti (ACL user mcp-gitlab, keys jti:mcp-gitlab:*, command SET).
MCP_REDIS_HOST=
MCP_REDIS_PORT=6379
MCP_REDIS_USER=mcp-gitlab
MCP_REDIS_PASSWORD=

# Registration data of the manifest (GET /mcp-manifest): the address the gateway reaches this server at.
MCP_INTERNAL_URL=https://mcp-gitlab.internal:8443/mcp
MCP_ACCEPTED_CREDENTIAL_TYPES=user-oauth,user-secret
